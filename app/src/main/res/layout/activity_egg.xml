<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/egg_background">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/frutiger_aero_bg"
        android:scaleType="centerCrop"
        android:alpha="0.7"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BICHITOS"
        android:textSize="32sp"
        android:textColor="#FF69B4"
        android:fontFamily="@font/pixel_font"
        android:shadowColor="#FF1493"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"/>

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/eggGif"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/egg_normal"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintBottom_toTopOf="@id/timeLeftText"
        app:layout_constraintWidth_max="300dp"
        app:layout_constraintHeight_max="300dp"/>

    <TextView
        android:id="@+id/timeLeftText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="05:00"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/pixel_font"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintTop_toBottomOf="@id/eggGif"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Touch or rub the egg!"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/pixel_font"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintTop_toBottomOf="@id/timeLeftText"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="4dp"/>

    <Button
        android:id="@+id/rubButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="RUB"
        android:backgroundTint="#FF69B4"
        android:fontFamily="@font/pixel_font"
        android:textSize="16sp"
        android:elevation="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tapButton"
        app:layout_constraintWidth_default="spread"
        app:layout_constraintHorizontal_chainStyle="spread_inside"/>

    <Button
        android:id="@+id/tapButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="TAP"
        android:backgroundTint="#4FC3F7"
        android:fontFamily="@font/pixel_font"
        android:textSize="16sp"
        android:elevation="4dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/rubButton"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_default="spread"/>

</androidx.constraintlayout.widget.ConstraintLayout>