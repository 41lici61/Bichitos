<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/frutiger_aero_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal"
        android:clipToPadding="false">

        <!-- Pet Name -->
        <TextView
            android:id="@+id/petNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 Bichito"
            android:textSize="28sp"
            android:textColor="#FF69B4"
            android:fontFamily="@font/pixel_font"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- Pet Image -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/pet_icon"
            android:layout_marginBottom="16dp"/>

        <!-- Pet Info Card -->
        <TextView
            android:id="@+id/petInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Info de la mascota"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pixel_font"
            android:gravity="center"
            android:background="#88000000"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:minHeight="150dp"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🍕 Feed"
                android:fontFamily="@font/pixel_font"
                android:backgroundTint="#4CAF50"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🎮 Play"
                android:fontFamily="@font/pixel_font"
                android:backgroundTint="#FF9800"
                android:textSize="14sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🧹 Clean"
                android:fontFamily="@font/pixel_font"
                android:backgroundTint="#2196F3"
                android:textSize="14sp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <!-- Care Button -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="❤️ Take Care!"
            android:fontFamily="@font/pixel_font"
            android:backgroundTint="#FF69B4"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</ScrollView>